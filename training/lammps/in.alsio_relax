# Relaxes an Al2SiO5 cell (types 1 Al, 2 Si, 3 O) with the Pedone potential at 0 GPa, triclinic box.
units           metal
atom_style      charge
boundary        p p p
read_data       ${dfile}
change_box      all triclinic
replicate       ${nx} ${ny} ${nz}
mass 1 26.9815
mass 2 28.085
mass 3 15.999
set type 1 charge 1.8
set type 2 charge 2.4
set type 3 charge -1.2
include         pedone_alsio_md.in
kspace_style    pppm 1.0e-5
fix             1 all box/relax tri 0.0 vmax 0.001
minimize        0 1e-10 20000 200000
variable        a equal lx/${nx}
variable        bb equal sqrt(ly*ly+xy*xy)/${ny}
variable        cc equal sqrt(lz*lz+xz*xz+yz*yz)/${nz}
variable        alpha equal acos((xy*xz+ly*yz)/(sqrt(ly*ly+xy*xy)*sqrt(lz*lz+xz*xz+yz*yz)))*180/PI
variable        beta equal acos(xz/sqrt(lz*lz+xz*xz+yz*yz))*180/PI
variable        gamma equal acos(xy/sqrt(ly*ly+xy*xy))*180/PI
print           "RELAXED a ${a} b ${bb} c ${cc} alpha ${alpha} beta ${beta} gamma ${gamma} pe/atom $(pe/atoms)"
