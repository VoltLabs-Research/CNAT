# Al2SiO5 polymorphs (kyanite, andalusite, sillimanite), liquid and glass with the Pedone et al. (2006)
# potential, snapshots for the Al2SiO5 CNAT models. Types 1 Al, 2 Si, 3 O. Crystals relax the full
# triclinic box (kyanite is P-1); liquids and glasses start from the kyanite cell.
# crystal : 3 ps NVT at temp, 5 ps anisotropic NPT at temp and 0 bar, then two 3 ps NPT legs.
# liquid  : 5 ps NVT at 5000 K (melts), 5 ps isotropic NPT at temp, then two 3 ps legs.
# glass   : 5 ps at 5000 K, 2 ps NPT at 3000 K, cooled to temp in 10 ps (270 K/ps at 300 K), 3 ps at temp.
# Short legs and the 8/10 A cutoffs of pedone_mgsio_md.in keep it affordable on a laptop.
#
# lmp -in in.alsio_md -var phase kyanite -var temp 900 -var seed 1 -var dfile kyanite.lmp -var nx 4 -var ny 4 -var nz 5

log             log.al2sio5.${phase}.${temp}K

units           metal
atom_style      charge
boundary        p p p
read_data       ${dfile}
change_box      all triclinic
replicate       ${nx} ${ny} ${nz}

mass 1 26.9815
mass 2 28.085
mass 3 15.999
set type 1 charge 1.8
set type 2 charge 2.4
set type 3 charge -1.2

include         pedone_alsio_md.in

neigh_modify    delay 0 every 1 check yes
thermo          1000
thermo_style    custom step time temp pe press vol lx ly lz xy xz yz
thermo_modify   flush yes

timestep        0.001
variable        tdamp equal 0.1
variable        pdamp equal 1.0

if "${phase} == kyanite || ${phase} == andalusite || ${phase} == sillimanite" then &
    "velocity all create ${temp} ${seed} mom yes rot yes dist gaussian" &
    "fix nvt1 all nvt temp ${temp} ${temp} ${tdamp}" &
    "run 3000" &
    "unfix nvt1" &
    "fix npt1 all npt temp ${temp} ${temp} ${tdamp} tri 0.0 0.0 ${pdamp}" &
    "run 5000"

if "${phase} == liquid" then &
    "velocity all create 5000 ${seed} mom yes rot yes dist gaussian" &
    "fix nvt1 all nvt temp 5000 5000 ${tdamp}" &
    "run 5000" &
    "unfix nvt1" &
    "fix npt1 all npt temp ${temp} ${temp} ${tdamp} iso 0.0 0.0 ${pdamp}" &
    "run 5000"

if "${phase} == glass" then &
    "velocity all create 5000 ${seed} mom yes rot yes dist gaussian" &
    "fix nvt1 all nvt temp 5000 5000 ${tdamp}" &
    "run 5000" &
    "unfix nvt1" &
    "fix npt0 all npt temp 3000 3000 ${tdamp} iso 0.0 0.0 ${pdamp}" &
    "run 2000" &
    "unfix npt0" &
    "fix npt0 all npt temp 3000 ${temp} ${tdamp} iso 0.0 0.0 ${pdamp}" &
    "run 10000" &
    "unfix npt0" &
    "fix npt1 all npt temp ${temp} ${temp} ${tdamp} iso 0.0 0.0 ${pdamp}" &
    "run 3000"

write_data      data.al2sio5.${phase}.${temp}K nocoeff
run             3000
write_data      data.al2sio5.${phase}.${temp}K.heldout nocoeff
run             3000
write_data      data.al2sio5.${phase}.${temp}K.extra nocoeff
