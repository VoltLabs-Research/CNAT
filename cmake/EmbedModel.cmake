# Writes OUTPUT, a C++ source defining Volt::kCnatEmbeddedModels from the .cnat files in INPUTS
# (a |-separated list); each model is named after its file stem, and the first one is the default.
string(REPLACE "|" ";" _inputs "${INPUTS}")
set(_arrays "")
set(_table "")
set(_index 0)
string(REPEAT "0x[0-9a-f][0-9a-f]," 24 _row)
foreach(_input IN LISTS _inputs)
    file(READ "${_input}" _hex HEX)
    string(LENGTH "${_hex}" _digits)
    math(EXPR _size "${_digits} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(REGEX REPLACE "(${_row})" "\\1\n" _bytes "${_bytes}")
    get_filename_component(_name "${_input}" NAME_WE)
    string(APPEND _arrays "alignas(4) const unsigned char kModel${_index}[] = {\n${_bytes}\n};\n\n")
    string(APPEND _table "    {\"${_name}\", kModel${_index}, ${_size}},\n")
    math(EXPR _index "${_index} + 1")
endforeach()
file(WRITE "${OUTPUT}"
"// Generated by cmake/EmbedModel.cmake; do not edit.\n"
"#include <volt/plugin/cnat_model.h>\n\n"
"namespace Volt {\n\n"
"namespace {\n\n${_arrays}}\n\n"
"extern const CnatModel::Embedded kCnatEmbeddedModels[];\n"
"extern const std::size_t kCnatEmbeddedModelCount;\n\n"
"const CnatModel::Embedded kCnatEmbeddedModels[] = {\n${_table}};\n"
"const std::size_t kCnatEmbeddedModelCount = ${_index};\n\n"
"}\n")
