{
  "workflow": {
    "nodes": [
      {
        "id": "plugin-metadata",
        "type": "modifier",
        "position": {
          "x": 240,
          "y": 160
        },
        "data": {
          "modifier": {
            "name": "CNAT: Comprehensive Neighbor Analysis Transformer",
            "key": "cnat",
            "icon": "HiCubeTransparent",
            "author": "VoltLabs Research",
            "license": "MIT",
            "version": "1.0.0",
            "homepage": "https://github.com/VoltLabs-Research/CNAT",
            "description": "Identifies the phase at atoms and at arbitrary points with a Transformer over the 79 nearest neighbours (CNAT; Watanabe, Sato & Shibuta, Comput. Mater. Sci. 2027), and exports the phase field and the solid-liquid interface. Built-in models: metals (liquid, FCC, HCP, BCC), Ni FCC/liquid (the paper's), and forsterite on its oxygen sublattice (olivine/disordered)."
          }
        }
      },
      {
        "id": "plugin-arguments",
        "type": "arguments",
        "position": {
          "x": 528,
          "y": 208
        },
        "data": {
          "arguments": {
            "arguments": [
              {
                "argument": "model",
                "type": "select",
                "label": "Model",
                "default": "metals",
                "options": [
                  {
                    "key": "metals",
                    "label": "Metals: liquid, FCC, HCP, BCC"
                  },
                  {
                    "key": "ni-fcc-liquid",
                    "label": "Ni FCC / liquid (paper)"
                  },
                  {
                    "key": "forsterite-o",
                    "label": "Forsterite, oxygen sublattice: olivine / disordered"
                  }
                ]
              },
              {
                "argument": "types",
                "type": "string",
                "label": "Neighbour Atom Types (e.g. 3 for the oxygens; empty = all)",
                "default": ""
              },
              {
                "argument": "threshold",
                "type": "number",
                "label": "Crystalline Probability Threshold",
                "default": 0.5,
                "min": 0.01,
                "max": 0.99,
                "step": 0.01
              },
              {
                "argument": "grid_spacing",
                "type": "number",
                "label": "Phase Field Grid Spacing (A, 0 = atoms only)",
                "default": 2.0,
                "min": 0,
                "step": 0.5
              },
              {
                "argument": "export_interface_mesh",
                "type": "boolean",
                "label": "Export Interface Mesh",
                "default": true
              },
              {
                "argument": "interface_smoothing",
                "type": "number",
                "label": "Interface Smoothing (A)",
                "default": 2.0,
                "min": 0,
                "step": 0.5
              },
              {
                "argument": "export_phase_field",
                "type": "boolean",
                "label": "Export Phase Field Points",
                "default": false
              }
            ]
          }
        }
      },
      {
        "id": "trajectory-context",
        "type": "context",
        "position": {
          "x": 816,
          "y": 160
        },
        "data": {
          "context": {
            "source": "trajectory_dumps"
          }
        }
      },
      {
        "id": "foreach-trajectory-dumps",
        "type": "forEach",
        "position": {
          "x": 1088,
          "y": 208
        },
        "data": {
          "forEach": {
            "iterableSource": "{{ trajectory-context.trajectory_dumps }}"
          }
        }
      },
      {
        "id": "analysis-entrypoint",
        "type": "entrypoint",
        "position": {
          "x": 1392,
          "y": 208
        },
        "data": {
          "entrypoint": {
            "type": "executable",
            "binary": "cnat",
            "binaryObjectPath": "__UPLOAD_BINARY_OBJECT_PATH__",
            "binaryFileName": "cnat",
            "arguments": "{{ foreach-trajectory-dumps.currentValue.path }} {{ foreach-trajectory-dumps.outputPath }} {{ plugin-arguments.as_str }}",
            "timeout": -1
          }
        }
      },
      {
        "id": "phase-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 128
        },
        "data": {
          "exposure": {
            "name": "Phase Identification",
            "icon": "HiCubeTransparent",
            "results": "atoms.parquet",
            "iterable": "",
            "properties": [
              {
                "key": "structure_id",
                "label": "Phase",
                "type": "int64",
                "enum": {
                  "0": "LIQUID / DISORDERED",
                  "1": "FCC / OLIVINE",
                  "2": "HCP",
                  "3": "BCC"
                }
              },
              {
                "key": "probability_crystalline",
                "label": "P(crystalline)",
                "type": "number"
              }
            ]
          }
        }
      },
      {
        "id": "phase-export",
        "type": "export",
        "position": {
          "x": 2032,
          "y": 128
        },
        "data": {
          "export": {
            "exporter": "AtomisticExporter",
            "type": "glb",
            "options": {
              "propertyColors": {
                "LIQUID": [
                  0.949,
                  0.949,
                  0.949,
                  1
                ],
                "DISORDERED": [
                  0.949,
                  0.949,
                  0.949,
                  1
                ],
                "FCC": [
                  0.4,
                  1,
                  0.4,
                  1
                ],
                "HCP": [
                  1,
                  0.4,
                  0.4,
                  1
                ],
                "BCC": [
                  0.4,
                  0.4,
                  1,
                  1
                ],
                "OLIVINE": [
                  0.55,
                  0.7,
                  0.2,
                  1
                ]
              }
            }
          }
        }
      },
      {
        "id": "interface-mesh-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 256
        },
        "data": {
          "exposure": {
            "name": "Solid-Liquid Interface",
            "icon": "HiCube",
            "results": "interface_mesh.parquet",
            "iterable": "",
            "exportWhen": {
              "argument": "export_interface_mesh",
              "operator": "equals",
              "value": true
            }
          }
        }
      },
      {
        "id": "interface-mesh-export",
        "type": "export",
        "position": {
          "x": 2032,
          "y": 256
        },
        "data": {
          "export": {
            "exporter": "MeshExporter",
            "type": "glb"
          }
        }
      },
      {
        "id": "phase-field-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 384
        },
        "data": {
          "exposure": {
            "name": "Phase Field",
            "icon": "HiCubeTransparent",
            "results": "phase_field.parquet",
            "iterable": "",
            "exportWhen": {
              "argument": "export_phase_field",
              "operator": "equals",
              "value": true
            },
            "properties": [
              {
                "key": "structure_id",
                "label": "Phase",
                "type": "int64",
                "enum": {
                  "0": "LIQUID / DISORDERED",
                  "1": "FCC / OLIVINE",
                  "2": "HCP",
                  "3": "BCC"
                }
              },
              {
                "key": "probability_crystalline",
                "label": "P(crystalline)",
                "type": "number"
              }
            ]
          }
        }
      },
      {
        "id": "phase-field-export",
        "type": "export",
        "position": {
          "x": 2032,
          "y": 384
        },
        "data": {
          "export": {
            "exporter": "AtomisticExporter",
            "type": "glb",
            "options": {
              "propertyColors": {
                "LIQUID": [
                  0.949,
                  0.949,
                  0.949,
                  1
                ],
                "DISORDERED": [
                  0.949,
                  0.949,
                  0.949,
                  1
                ],
                "FCC": [
                  0.4,
                  1,
                  0.4,
                  1
                ],
                "HCP": [
                  1,
                  0.4,
                  0.4,
                  1
                ],
                "BCC": [
                  0.4,
                  0.4,
                  1,
                  1
                ],
                "OLIVINE": [
                  0.55,
                  0.7,
                  0.2,
                  1
                ]
              }
            }
          }
        }
      },
      {
        "id": "summary-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 512
        },
        "data": {
          "exposure": {
            "name": "Phase Summary",
            "icon": "HiChartBar",
            "results": "cnat.parquet",
            "iterable": "",
            "hasListing": true,
            "panel": {
              "tables": [
                {
                  "source": "structure_counts",
                  "title": "Atoms",
                  "label": "structure_name",
                  "colorBy": "structure_name",
                  "colors": {
                    "LIQUID": [
                      0.949,
                      0.949,
                      0.949,
                      1
                    ],
                    "DISORDERED": [
                      0.949,
                      0.949,
                      0.949,
                      1
                    ],
                    "FCC": [
                      0.4,
                      1,
                      0.4,
                      1
                    ],
                    "HCP": [
                      1,
                      0.4,
                      0.4,
                      1
                    ],
                    "BCC": [
                      0.4,
                      0.4,
                      1,
                      1
                    ],
                    "OLIVINE": [
                      0.55,
                      0.7,
                      0.2,
                      1
                    ]
                  },
                  "columns": [
                    {
                      "column": "count",
                      "label": "Count",
                      "format": "integer"
                    },
                    {
                      "column": "fraction",
                      "label": "Fraction",
                      "format": "percent"
                    }
                  ]
                },
                {
                  "source": "volume_fractions",
                  "title": "Phase field (grid points)",
                  "label": "structure_name",
                  "colorBy": "structure_name",
                  "colors": {
                    "LIQUID": [
                      0.949,
                      0.949,
                      0.949,
                      1
                    ],
                    "DISORDERED": [
                      0.949,
                      0.949,
                      0.949,
                      1
                    ],
                    "FCC": [
                      0.4,
                      1,
                      0.4,
                      1
                    ],
                    "HCP": [
                      1,
                      0.4,
                      0.4,
                      1
                    ],
                    "BCC": [
                      0.4,
                      0.4,
                      1,
                      1
                    ],
                    "OLIVINE": [
                      0.55,
                      0.7,
                      0.2,
                      1
                    ]
                  },
                  "columns": [
                    {
                      "column": "grid_points",
                      "label": "Grid points",
                      "format": "integer"
                    },
                    {
                      "column": "fraction",
                      "label": "Volume fraction",
                      "format": "percent"
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    ],
    "edges": [
      {
        "id": "edge-plugin-metadata-plugin-arguments",
        "source": "plugin-metadata",
        "sourceHandle": "output",
        "target": "plugin-arguments",
        "targetHandle": "input"
      },
      {
        "id": "edge-plugin-arguments-trajectory-context",
        "source": "plugin-arguments",
        "sourceHandle": "output",
        "target": "trajectory-context",
        "targetHandle": "input"
      },
      {
        "id": "edge-trajectory-context-foreach-trajectory-dumps",
        "source": "trajectory-context",
        "sourceHandle": "output",
        "target": "foreach-trajectory-dumps",
        "targetHandle": "input"
      },
      {
        "id": "edge-foreach-trajectory-dumps-analysis-entrypoint",
        "source": "foreach-trajectory-dumps",
        "sourceHandle": "output",
        "target": "analysis-entrypoint",
        "targetHandle": "input"
      },
      {
        "id": "edge-analysis-entrypoint-phase-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "phase-exposure",
        "targetHandle": "input"
      },
      {
        "id": "edge-phase-exposure-phase-export",
        "source": "phase-exposure",
        "sourceHandle": "output",
        "target": "phase-export",
        "targetHandle": "input"
      },
      {
        "id": "edge-analysis-entrypoint-interface-mesh-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "interface-mesh-exposure",
        "targetHandle": "input"
      },
      {
        "id": "edge-interface-mesh-exposure-interface-mesh-export",
        "source": "interface-mesh-exposure",
        "sourceHandle": "output",
        "target": "interface-mesh-export",
        "targetHandle": "input"
      },
      {
        "id": "edge-analysis-entrypoint-phase-field-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "phase-field-exposure",
        "targetHandle": "input"
      },
      {
        "id": "edge-phase-field-exposure-phase-field-export",
        "source": "phase-field-exposure",
        "sourceHandle": "output",
        "target": "phase-field-export",
        "targetHandle": "input"
      },
      {
        "id": "edge-analysis-entrypoint-summary-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "summary-exposure",
        "targetHandle": "input"
      }
    ]
  },
  "interface": {
    "version": 2,
    "provides": {
      "volt/per-atom-properties@1": {
        "atoms": "atoms.parquet"
      }
    }
  }
}
